# Copy to .env (make up does this for you if .env is missing).
# Local development credentials only. The port is bound to 127.0.0.1.
POSTGRES_USER=lims_admin
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=ngs_lims
# Host port. 5433 avoids clashing with a Postgres you might already run on 5432.
PGPORT=5433
